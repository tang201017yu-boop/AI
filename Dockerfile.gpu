# OpenCV Platform Dockerfile - GPU 优化版本
# 优化目标：充分发挥 RTX 5080 性能，支持 CUDA 加速训练和推理

# ============== 第一阶段：PyTorch CUDA 基础 ==============
FROM nvidia/cuda:12.6-cudnn9-runtime-ubuntu22.04 AS pytorch-base

LABEL maintainer="OpenCV Platform"
LABEL description="基于 Ultralytics YOLO 的开源计算机视觉平台 (GPU 加速)"

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ENV PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_NO_CACHE_DIR=1
ENV PIP_TIMEOUT=120
ENV PIP_RETRIES=5

# 安装 Python 和 PyTorch GPU 版本
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-dev \
    python3-pip \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 使用清华源安装 PyTorch GPU 版本（CUDA 12.6）
# RTX 5080 需要 CUDA 12.4+ 和 PyTorch 2.5+
RUN pip install --no-cache-dir \
        torch==2.5.1+cu126 \
        torchvision==0.20.1+cu126 \
        torchaudio==2.5.1+cu126 \
        --index-url https://pypi.tuna.tsinghua.edu.cn/simple/torch \
        --extra-index-url https://download.pytorch.org/whl/cu126 \
    || pip install --no-cache-dir \
        torch torchvision torchaudio \
        --index-url https://download.pytorch.org/whl/cu126

# ============== 第二阶段：构建依赖 ==============
FROM pytorch-base AS builder

WORKDIR /build

# 安装编译工具
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    make \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 复制并安装依赖
COPY requirements.txt .

# 分步安装依赖
RUN pip install --no-cache-dir ultralytics

RUN pip install --no-cache-dir \
    opencv-python supervision Pillow pyyaml albumentations \
    psycopg2-binary psycopg[binary] pgvector boto3 requests \
    fastapi uvicorn[standard] python-multipart jinja2

# ============== 第三阶段：运行时 ==============
FROM nvidia/cuda:12.6-cudnn9-runtime-ubuntu22.04 AS runtime

LABEL maintainer="OpenCV Platform"
LABEL description="基于 Ultralytics YOLO 的开源计算机视觉平台 (GPU 加速)"

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ENV PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_NO_CACHE_DIR=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV NVIDIA_DISABLE_REQUIRE=1

# 安装运行时依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 跨阶段复制（包含 PyTorch GPU 版本）
COPY --from=pytorch-base /usr/local/lib/python3.12/site-packages/ /usr/local/lib/python3.12/site-packages/
COPY --from=pytorch-base /usr/local/bin/ /usr/local/bin/
COPY --from=builder /usr/local/lib/python3.12/site-packages/ /usr/local/lib/python3.12/site-packages/
COPY --from=builder /usr/local/bin/ /usr/local/bin/

# 复制应用代码
COPY backend /app/backend
COPY config /app/config
COPY frontend /app/frontend
COPY scripts /app/scripts
COPY app.py requirements.txt /app/

# 创建目录
WORKDIR /app
RUN mkdir -p data/datasets data/models data/exports data/uploads logs frontend/static

# 非 root 用户
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app && \
    chmod -R 755 /app && \
    chmod -R 777 /app/data /app/logs

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/system/health').read()" || exit 1

CMD ["python", "app.py"]
