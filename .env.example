# 环境配置示例文件
# 复制此文件为 .env 并根据实际情况修改

# 应用配置
APP_NAME=OpenCV Platform
APP_VERSION=2.0.0
DEBUG=True

# 服务端口
API_PORT=8000

# 数据路径
DATA_DIR=./data
DATASETS_DIR=./data/datasets
MODELS_DIR=./data/models
EXPORTS_DIR=./data/exports
UPLOADS_DIR=./data/uploads
ANNOTATION_PROJECTS_DIR=./data/annotation_projects

# 模型配置
DEFAULT_MODEL=yolo11n.pt
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# ==================== 训练配置 (RTX 5080 优化) ====================
# 训练轮数
DEFAULT_EPOCHS=100

# 批大小 - RTX 5080 (16GB) 建议:
#   - yolo11n/yolo11s: 32-64
#   - yolo11m: 16-32
#   - yolo11l/x: 8-16
DEFAULT_BATCH_SIZE=32

# 输入图片尺寸
DEFAULT_IMG_SIZE=640

# 最大并行训练任务数
MAX_TRAINING_WORKERS=2

# ==================== GPU 优化配置 (RTX 5080) ====================
# 混合精度训练 (AMP) - 强烈建议开启，可提速 1.5-2x
DEFAULT_AMP=True

# 数据加载线程数 - 根据 CPU 核心数调整，RTX 5080 建议 8-12
DEFAULT_WORKERS=8

# 数据缓存类型: none, ram, disk
# none: 不缓存 (慢，但省内存)
# ram: 缓存到内存 (最快，推荐 16GB+ 显存)
# disk: 缓存到磁盘 (平衡)
DEFAULT_CACHE=ram

# ==================== 标注配置 ====================
AUTO_ANNOTATION_CONFIDENCE=0.25
AUTO_ANNOTATION_IOU=0.45

# ==================== API 配置 ====================
MAX_UPLOAD_SIZE=500  # MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,bmp,mp4,avi,mov

# ==================== PostgreSQL 数据库配置 ====================
# 使用 Docker Compose 时会自动设置这些值
# 如果使用外部数据库，请取消注释并修改
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opencv_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_SIZE=10

# ==================== S3/MinIO 存储配置 ====================
# 使用 Docker Compose 时会自动设置 MinIO
# 如果使用外部 S3 服务（如 AWS S3），请修改以下配置
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=opencv-platform
S3_REGION=us-east-1
S3_USE_SSL=false

# 存储后端选择: s3 或 local
STORAGE_BACKEND=s3

# ==================== 向量搜索配置 ====================
# 是否启用 pgvector 向量搜索
USE_VECTOR_SEARCH=true
