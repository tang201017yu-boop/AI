# OpenCV Platform - RTX 5080 环境配置示例
# 复制此文件为 .env 并根据实际情况修改

# ==================== 应用配置 ====================
APP_NAME=OpenCV Platform (RTX 5080)
APP_VERSION=2.2.0
DEBUG=True
API_PORT=8000

# ==================== 存储后端 ====================
# local: 本地存储 (推荐用于开发)
# s3: S3/MinIO 存储 (推荐用于生产)
STORAGE_BACKEND=local

# ==================== 数据路径 ====================
DATA_DIR=./data
DATASETS_DIR=./data/datasets
MODELS_DIR=./data/models
EXPORTS_DIR=./data/exports
UPLOADS_DIR=./data/uploads
ANNOTATION_PROJECTS_DIR=./data/annotation_projects

# ==================== 模型配置 ====================
DEFAULT_MODEL=yolo26n.pt
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# ==================== 训练配置 (RTX 5080 优化 - 16GB显存) ====================
DEFAULT_EPOCHS=100

# 批大小建议 (RTX 5080 16GB):
#   - yolo26n/yolo26s: 32-64
#   - yolo26m: 16-32
#   - yolo26l/x: 8-16
DEFAULT_BATCH_SIZE=32
DEFAULT_IMG_SIZE=640
MAX_TRAINING_WORKERS=8

# ==================== PyTorch / 显卡 (RTX50/Blackwell 等) ====================
# 1 表示强制全进程用 CPU(慢但稳定；代码也会在检测到无可用 CUDA kernel 时自动回退)
# TORCH_FORCE_CPU=0

# ==================== GPU 优化配置 ====================
DEFAULT_AMP=True           # 混合精度训练 - 提速 1.5-2x
DEFAULT_WORKERS=8          # 数据加载线程数
DEFAULT_CACHE=ram          # 数据缓存: none/ram/disk

# CUDA 优化
CUDA_LAUNCH_BLOCKING=0     # 异步 CUDA
CUDA_TF32=1                # TF32 加速 (RTX 30/40)
CUDNN_BENCHMARK=1          # cuDNN 自动调优

# ==================== API 配置 ====================
MAX_UPLOAD_SIZE=500  # MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,bmp,mp4,avi,mov,zip

# ==================== PostgreSQL 配置 ====================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opencv_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_SIZE=10

# ==================== S3/MinIO 配置 ====================
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=opencv-platform
S3_REGION=us-east-1
S3_USE_SSL=false

# ==================== 向量搜索 ====================
USE_VECTOR_SEARCH=false
