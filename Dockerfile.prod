# OpenCV Platform Production Dockerfile - 生产环境优化版
# 优化目标：体积最小化、拉取最快、适合国内服务器大规模部署

# ============== 第一阶段：构建依赖 ==============
FROM python:3.12-slim AS builder

LABEL maintainer="OpenCV Platform"
LABEL description="基于 Ultralytics YOLO 的开源计算机视觉平台 (生产版)"

WORKDIR /build

# 配置国内 pip 源（提速 5 倍+）
ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ENV PIP_EXTRA_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ENV PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_NO_CACHE_DIR=1
ENV PIP_CONNECTION_TIMEOUT=60
ENV PIP_RETRIES=3
ENV PIP_FIND_LINKS=https://mirror.sjtu.edu.cn/pytorch-wheels

# 安装编译工具和构建依赖（仅用于某些需要编译的包）
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    make \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 复制依赖文件并下载 wheel 包
COPY requirements.txt .

# 使用预编译 wheel（CPU 版本，无需编译）
# 优先使用清华镜像，fallback 到官方
RUN pip install --no-cache-dir --prefix=/install \
    torch torchvision torchaudio \
    --index-url https://pypi.tuna.tsinghua.edu.cn/simple/torch \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    --trusted-host pypi.tuna.tsinghua.edu.cn || \
    pip install --no-cache-dir --prefix=/install \
        torch torchvision torchaudio \
        --index-url https://download.pytorch.org/whl/cpu

# 再安装其他依赖（使用 --prefer-binary 优先使用二进制包）
RUN pip download --no-cache-dir -r requirements.txt -d /tmp/wheels && \
    pip install --no-cache-dir --prefix=/install \
        --no-index --find-links=/tmp/wheels \
        --prefer-binary \
        -r requirements.txt

# ============== 第二阶段：运行时 ==============
FROM python:3.12-slim AS runtime

LABEL maintainer="OpenCV Platform"
LABEL description="基于 Ultralytics YOLO 的开源计算机视觉平台 (Python 3.12 生产版)"
LABEL version="2.1.0"

# 配置国内 pip 源
ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ENV PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_NO_CACHE_DIR=1

# 环境变量
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    DEBIAN_FRONTEND=noninteractive \
    NVIDIA_DISABLE_REQUIRE=1

# 使用阿里云镜像站作为 apt 源（国内服务器提速）
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources && \
    sed -i 's/security.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources

# 安装运行时系统依赖（最小化，Debian trixie 适配）
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    libxcb1 \
    libxkbcommon0 \
    libdrm2 \
    libgbm1 \
    libasound2 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 从第一阶段复制已安装的 Python 包
COPY --from=builder /install /usr/local

# 创建必要的目录结构
RUN mkdir -p \
    /app/data/datasets \
    /app/data/models \
    /app/data/exports \
    /app/data/uploads \
    /app/data/annotation_projects \
    /app/logs \
    /app/frontend/static

# 复制应用代码
COPY backend /app/backend
COPY config /app/config
COPY frontend /app/frontend
COPY scripts /app/scripts
COPY app.py requirements.txt /app/

# 非 root 用户运行（安全最佳实践）
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app && \
    chmod -R 755 /app && \
    chmod -R 777 /app/data && \
    chmod -R 777 /app/logs

USER appuser

# 暴露端口
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/system/health').read()" || exit 1

# 启动命令
CMD ["python3", "app.py"]
